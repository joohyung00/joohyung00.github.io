<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ profile.name }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ profile.description }}{% endblock %}">
<link rel="canonical" href="{{ profile.site_url }}/{% block canonical %}{% endblock %}">
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:image" content="{% block ogimage %}{{ profile.site_url }}/assets/img/portrait.jpg{% endblock %}">
<meta property="og:url" content="{{ profile.site_url }}/{{ self.canonical() }}">
<meta name="twitter:card" content="summary">
<link rel="icon" href="{{ root }}assets/img/kirby.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
{% if inline %}
<style>{{ inline_css | safe }}</style>
{% else %}
<link rel="stylesheet" href="{{ root }}assets/site.css">
{% endif %}
<script>
/* apply the saved theme before first paint */
(function(){try{var m=localStorage.getItem('mode');if(!m&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)m='dark';if(m)document.documentElement.setAttribute('data-mode',m);}catch(e){}})();
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Person","name":"{{ profile.name }}","url":"{{ profile.site_url }}/","email":"{{ profile.email }}","affiliation":{"@type":"Organization","name":"{{ profile.univ }}"},"sameAs":["{{ profile.scholar }}","https://github.com/joohyung00"]}
</script>
</head>
<body id="top">
<div class="nav"><div class="in">
  <a class="brand" href="{{ root }}#top">{{ profile.name }}</a>
  <nav aria-label="Pages">
    <a href="{{ root }}talks/"{% if nav_on == "talks" %} class="on"{% endif %}>Talks</a><a href="{{ root }}seminars/"{% if nav_on == "seminars" %} class="on"{% endif %}>Seminars</a><a href="{{ profile.posts_url }}">Posts</a><a href="{{ root }}{{ profile.cv_pdf }}" title="Curriculum vitae (PDF)">CV ↗</a>
  </nav>
  <button class="themeToggle" type="button" title="Toggle dark mode" aria-label="Toggle dark mode">☾</button>
</div></div>
<div class="wrap">
{% block body %}{% endblock %}
<footer>
  <span><a href="mailto:{{ profile.email }}">{{ profile.email }}</a> · updated {{ build_month }}</span>
  <span><a href="{{ profile.posts_url }}">Posts ↗</a> · <a href="{{ root }}{{ profile.legacy_url }}" title="Previous versions of this site">legacy ↗</a> · <a href="#top">top ↑</a></span>
</footer>
</div>
{% if inline %}
<script>{{ inline_js | safe }}</script>
{% else %}
<script src="{{ root }}assets/site.js" defer></script>
{% endif %}
</body>
</html>
