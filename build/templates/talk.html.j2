{% extends "base.html.j2" %}
{% block title %}{{ t.pub.title }} · {{ t.venue }} · {{ profile.name }}{% endblock %}
{% block canonical %}talks/{{ t.key }}/{% endblock %}
{% block description %}{{ 'Slides' if t.slides else 'Poster' }} from {{ t.venue }} ({{ t.where }}, {{ t.date }}): {{ t.pub.title }}.{% endblock %}
{% block ogimage %}{{ profile.site_url }}/assets/talks/{{ t.key }}/{{ 'slides/01.webp' if t.slides else 'poster_thumb.webp' }}{% endblock %}
{% block body %}
{% set base = root ~ 'assets/talks/' ~ t.key ~ '/' %}

<header class="talkhead">
  <div class="mono"><a href="{{ root }}talks/">Talks &amp; posters</a> › {{ t.venue }}</div>
  <h1>{{ t.pub.title }}</h1>
  <div class="au">{{ t.pub.authors | bold_self(profile.me) | safe }}</div>
  <div class="meta"><span class="badge">{{ t.venue }}</span><span class="mono">{% if t.venue_long %}{{ t.venue_long }} · {% endif %}{{ t.where }} · {{ t.date }}</span></div>
  <div class="links">
    {% if t.slides %}<a href="{{ base }}slides.pdf">slides.pdf</a>{% endif %}
    {% if t.poster %}<a href="{{ base }}poster.pdf">poster.pdf</a>{% endif %}
    {% for label, url in t.pub.links.items() if label not in ('Slides', 'Poster') %}<a href="{{ url }}">{{ label | lower }}</a>{% endfor %}
  </div>
</header>

{% if t.slides %}
<section class="viewer" id="slides" data-viewer>
  <div class="stage">
    <div class="track" tabindex="0" aria-label="Slides, use arrow keys">
      {% for i in range(1, t.slides + 1) %}<figure><img src="{{ base }}slides/{{ '%02d' % i }}.webp" alt="Slide {{ i }}" width="1280" height="720"{% if i > 2 %} loading="lazy"{% endif %}></figure>{% endfor %}
    </div>
    <button type="button" class="arrow prev" aria-label="Previous slide">‹</button>
    <button type="button" class="arrow next" aria-label="Next slide">›</button>
  </div>
  <div class="bar">
    <span class="count mono"><b>1</b> / {{ t.slides }}</span>
    <span class="hint mono">← → keys · swipe · click a thumbnail</span>
    <button type="button" class="linkbtn fs">fullscreen ⤢</button>
  </div>
  <div class="rail" aria-label="Slide thumbnails">
    {% for i in range(1, t.slides + 1) %}<button type="button" data-i="{{ i - 1 }}" aria-label="Go to slide {{ i }}"><img src="{{ base }}slides/thumb/{{ '%02d' % i }}.webp" alt="" width="320" height="180" loading="lazy"></button>{% endfor %}
  </div>
</section>
{% endif %}

{% if t.poster %}
<section class="poster" id="poster">
  <div class="h2m">Poster</div>
  <a href="{{ base }}poster.webp" title="Open full size"><img src="{{ base }}poster.webp" alt="{{ t.pub.title }} poster" width="{{ t.poster.w }}" height="{{ t.poster.h }}"{% if t.slides %} loading="lazy"{% endif %}></a>
  <div class="mono">click to open full size · <a href="{{ base }}poster.pdf">poster.pdf</a></div>
</section>
{% endif %}

<p class="backlink"><a href="{{ root }}talks/">← all talks &amp; posters</a></p>

{% endblock %}
